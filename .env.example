# External channel credentials are server-side only.
# Configure real values in the hosted Sites environment, never in browser code.

# --- AI one-click generation (OpenAI-compatible chat/completions) ---
# All three are required to enable /api/generate; when missing, the route
# returns AI_NOT_CONFIGURED (503) and the copy-prompt flow keeps working.
# Examples:
#   OpenAI:            AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-5.2
#   Anthropic-compat:  AI_BASE_URL=https://api.anthropic.com/v1     AI_MODEL=claude-sonnet-5 (需网关支持 chat/completions)
#   Any OpenAI-compatible gateway (OpenRouter / Cloudflare AI Gateway / vLLM) works.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- X / Twitter ---
X_BEARER_TOKEN=
# 必须是数字 User ID（非 @handle），可通过 https://tweeterid.com 查询
X_USER_ID=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
# 必填：官方发布者的 Discord 用户 ID，未配置时拒绝同步
DISCORD_AUTHOR_ID=

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202603

# --- Reddit ---
# 推荐：配置 OAuth 凭证以避免数据中心 IP 被 RSS 限流（429）
# 在 https://www.reddit.com/prefs/apps 创建 script 类型应用
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Instagram ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# 格式如 v23.0，参见 https://developers.facebook.com/docs/graph-api/changelog
INSTAGRAM_GRAPH_VERSION=

# --- TikTok ---
TIKTOK_ACCESS_TOKEN=

# --- 飞书 ---
# 自建应用凭证，绝不暴露给浏览器端
FEISHU_APP_ID=
FEISHU_APP_SECRET=
